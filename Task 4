
# Data Cleaning & Reporting Automation
# Python, Pandas, Matplotlib

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from pathlib import Path

# 1. Create sample dataset
data = {
    "Name": ["Ravi", "Priya", "Arun", "Meena", "Ravi", "Kumar", None],
    "Department": ["CSE", "IT", "CSE", "ECE", "CSE", "IT", "ECE"],
    "Salary": [35000, 45000, np.nan, 40000, 35000, 50000, 38000],
    "Age": [22, 23, 21, np.nan, 22, 24, 22]
}

df = pd.DataFrame(data)

print("ORIGINAL DATA")
print(df.to_string(index=False))
print("\nOriginal shape:", df.shape)

# 2. Clean text fields
for col in ["Name", "Department"]:
    df[col] = df[col].apply(
        lambda x: x.strip().title() if isinstance(x, str) else x
    )

df["Department"] = df["Department"].replace({
    "Cse": "CSE",
    "It": "IT",
    "Ece": "ECE"
})

# 3. Handle missing values
df["Name"] = df["Name"].fillna("Unknown")
df["Salary"] = df["Salary"].fillna(df["Salary"].median())
df["Age"] = df["Age"].fillna(df["Age"].median())

# 4. Remove duplicate records
before = len(df)
df = df.drop_duplicates().reset_index(drop=True)
duplicates_removed = before - len(df)

# 5. Validate data
df["Salary"] = pd.to_numeric(df["Salary"], errors="coerce")
df["Age"] = pd.to_numeric(df["Age"], errors="coerce")

# 6. Generate summary report
summary = df.describe(include="all").transpose()

department_report = (
    df.groupby("Department")
      .agg(
          Employee_Count=("Name", "size"),
          Average_Salary=("Salary", "mean"),
          Average_Age=("Age", "mean")
      )
      .round(2)
)

print("\nCLEANED DATA")
print(df.to_string(index=False))

print("\nCLEANING REPORT")
print("Rows remaining:", len(df))
print("Duplicate rows removed:", duplicates_removed)
print("Missing values remaining:", int(df.isnull().sum().sum()))

print("\nDEPARTMENT REPORT")
print(department_report)

# 7. Visualize average salary by department
department_report["Average_Salary"].plot(
    kind="bar",
    figsize=(8, 5),
    title="Average Salary by Department"
)

plt.xlabel("Department")
plt.ylabel("Average Salary")
plt.xticks(rotation=0)
plt.tight_layout()
plt.savefig("salary_report.png")
plt.show()

# 8. Export cleaned data and reports
df.to_csv("cleaned_data.csv", index=False)
summary.to_csv("data_summary_report.csv")
department_report.to_csv("department_report.csv")

# 9. Create automated text report
with open("cleaning_report.txt", "w", encoding="utf-8") as file:
    file.write("DATA CLEANING AND REPORTING AUTOMATION\n")
    file.write("=" * 40 + "\n")
    file.write(f"Rows after cleaning: {len(df)}\n")
    file.write(f"Duplicate rows removed: {duplicates_removed}\n")
    file.write(
        f"Missing values remaining: {int(df.isnull().sum().sum())}\n\n"
    )
    file.write("DEPARTMENT SUMMARY\n")
    file.write(department_report.to_string())

print("\nSUCCESS! Reports generated:")
print("1. cleaned_data.csv")
print("2. data_summary_report.csv")
print("3. department_report.csv")
print("4. cleaning_report.txt")
print("5. salary_report.png")
